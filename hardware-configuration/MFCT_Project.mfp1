                </PropertyElement>
                <PropertyElement Name="Description">
                  <Value xsi:type="xsd:string">Interface module with MultiFieldbus interface with integrated 2-port switch; supports PROFINET RT, EtherNet/IP and Modbus TCP; 64 I/O modules plus 16 ET 200AL modules; Shared Device with local data coupling for up to 6 controllers; module replacement during operation (Multi Hot Swap); start with empty slots; Module-to-Module communication (MtM); media redundancy (MRP); configuration control via PLC; Shared Input/Output (MSI/MSO); S2 system redundancy; PROFIenergy; user data up to max. 288 bytes per I/O module; supports module allocation; set time; firmware V5.2</Value>
                </PropertyElement>
                <PropertyElement Name="SoftwareRelease">
                  <Value xsi:type="xsd:string">V5.2</Value>
                </PropertyElement>
