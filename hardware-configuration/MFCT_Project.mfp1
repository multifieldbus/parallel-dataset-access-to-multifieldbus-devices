                  <Value xsi:type="xsd:string">AI Energy Meter RC HF V8.0 (032I/020O)</Value>
                </PropertyElement>
                <PropertyElement Name="SlotNumber">
                  <Value xsi:type="xsd:unsignedShort">4</Value>
                </PropertyElement>
                <PropertyElement Name="ID">
                  <Value xsi:type="xsd:string">AI Energymeter RC HF V8.0 (32I/20O)</Value>
                </PropertyElement>
                <PropertyElement Name="OrderNumber">
                  <Value xsi:type="xsd:string">6ES7 134-6PA21-0CU0</Value>
                </PropertyElement>
                <PropertyElement Name="ModuleIdentNumber">
                  <Value xsi:type="xsd:unsignedInt">19470</Value>
                </PropertyElement>
                <PropertyElement Name="Description">
                  <Value xsi:type="xsd:string">Analog input module AI Energy Meter RC HF; 1-, 2- or 3-phase measurement of current and voltage; current measurement via Rogowski coils or current/voltage transformer; voltage measurement with/without voltage transformer; neutral conductor current; power; continuous and periodic retentive energy counter; operating hours counter; channel-specific diagnostics; cyclic and acyclic measured values; limit monitoring; cyclic and acyclic measured values can be configured by user, cyclic measured values via EE@Industry; measurement of fundamental values; network analysis functions; measured value recorder; network failure analysis (recording for network failure and network return)</Value>
                </PropertyElement>
                <PropertyElement Name="SoftwareRelease">
                  <Value xsi:type="xsd:string">V8.0</Value>
                </PropertyElement>
              </Properties>
